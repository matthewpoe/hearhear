# Copy to .env for local development. Never commit .env.
# fixture: replay contracts/fixtures/tutor (default, no key needed). live: call Claude.
TUTOR_MODE=fixture
TUTOR_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Daily in-memory token budget (input + output). The hard cap is the Console spend limit.
TUTOR_DAILY_TOKEN_BUDGET=2000000
