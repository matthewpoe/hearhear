# Copy to .env for local development. Never commit .env.
# fixture: replay contracts/fixtures/tutor (default, no key needed). live: call Claude.
TUTOR_MODE=fixture
TUTOR_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Live-mode passphrase, sent as X-Tutor-Access; required when TUTOR_MODE=live. Never commit a value.
TUTOR_ACCESS_CODE=
# Daily in-memory token budget (input + output). The hard cap is the Console spend limit.
TUTOR_DAILY_TOKEN_BUDGET=500000
# Per-client-IP rate limit on /api/tutor (slowapi syntax). Raise it for the eval harness.
TUTOR_RATE_LIMIT=10/minute;100/day
